rules_version = '2';

// =============================================================================
//  梁平鑫系統 Firestore Rules — 人事授權來源保護候選（尚未部署）
//  前版：2026/09/17 已部署，模擬器 29 項測試通過；本候選測試另行記錄。
//  基準：repo firestore.rules（2026/09/16 Console 匯出）
//  部署與測試紀錄以 CODEX交接文件_梁平鑫系統.md §4 為準。
//
//  已修補：
//   [users 提權] 已解決：店長／顧問不得修改角色、門市範圍等權限欄位；
//       新帳號僅能建立 employee 空殼，本人登入紀錄僅可更新 lastLoginAt。
//       權限欄位僅 admin 可改，且 admin 不得自改權限欄位或刪除自己。
//   [兜底繞過] 已解決：/{col}/{doc=**} 排除 users，避免 OR 語意繞過限制。
//   [SEC-05] 角色授權檢查已修補：所有角色判斷加入 isActive()，
//       停用帳號無法取得管理職讀寫權；缺 disabled 欄位視為未停用。
//       僅需登入／本人身分的規則仍維持原邏輯，Auth 撤銷 token 尚待後端處理。
//   [授權來源／本候選] hr/employees、hr/resigned、hr/_version 僅允許受控後端寫入，
//       包含其深層路徑；hr_source_audit 僅 admin 可讀、client 不可寫。
//       必須與所有前端寫入路徑遷移及後端同批啟用，不可單獨部署此規則。
//
//  仍待處理（本次未擴大修補）：
//   [SEC-02/03] 跨店資料隔離仍僅靠前端 normLoc()；Rules 未限制管理職的店別。
//       需先補穩定 storeId 與受控讀取路徑。
//   [SEC-02] store_accounts 密碼仍為明文且 staff 可整批讀取；
//       待目錄／秘密分離與後端單筆揭露。
//   [授權來源] 本候選須完成受控後端、前端遷移及部署驗收，才能認定正式修補完成。
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function meRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function meExists() {
      return request.auth != null && exists(meRef());
    }
    function me() {
      return get(meRef()).data;
    }
    function isLoggedIn() {
      return request.auth != null;
    }
    // [3] 缺欄位 = 未停用；使用者文件不存在 = 不啟用
    function isActive() {
      return meExists() && me().get('disabled', false) != true;
    }
    function roleOf() {
      return me().get('role', '');
    }
    function isAdminA()   { return isActive() && roleOf() == 'admin'; }
    function isAcctMgrA() { return isActive() && roleOf() in ['admin', 'consultant']; }
    function isStaffA()   { return isActive() && roleOf() in ['admin', 'consultant', 'manager']; }

    // 影響授權的欄位（admin 亦不得自改這些欄位）
    function PERM_KEYS() {
      return ['role', 'locations', 'workLocation', 'disabled', 'empId', 'idNo'];
    }

    match /users/{uid} {
      allow read: if isLoggedIn() && (request.auth.uid == uid || isStaffA());

      // ── 本人：只能寫 lastLoginAt（employee 亦適用）──
      allow update: if isLoggedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);

      // ── 受控建立：只能建無權限空殼 ──
      // ⚠ 建帳號是 hr.html / batch_accounts.html 的流程，屬 hr 模組而非 account 模組，
      //   故此處維持 isStaffA()。若 hr 模組線上角色也只有 admin，應一併收緊。
      //    比對 hr.html（2070-2130）與 batch_accounts.html（290-294）的實際寫入欄位：
      //    hr.html          → empId, idNo, name, role:'employee', createdAt
      //    batch_accounts   → empId, idNo, name, role:'employee', disabled:false, createdAt
      allow create: if isStaffA()
        && request.resource.data.role == 'employee'
        && request.resource.data.get('disabled', false) == false
        && !('locations' in request.resource.data)
        && !('workLocation' in request.resource.data)
        && request.resource.data.keys().hasOnly(
             ['empId', 'idNo', 'name', 'role', 'disabled', 'createdAt', 'lastLoginAt']);

      // ── 權限欄位：僅 admin ──
      // ⚠ 依 2026/09/17 Console 實測，settings/permissions.modules.account.roles
      //   線上實際值為 ["admin"]（非 permissions.html 預設的 admin+consultant）。
      //   顧問本來就不該進帳號管理，故此處不開放 consultant，
      //   避免「補漏洞反而擴權」。
      //   若日後管理層決定開放顧問，須同步改 settings/permissions、重新設計規則並重跑 rules.test.js。
      allow update: if isAdminA()
        && (request.auth.uid != uid                     // admin 不得自改權限欄位
            || !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(PERM_KEYS()));
      allow delete: if isAdminA() && request.auth.uid != uid;
    }

    // ── 人事授權來源：瀏覽器不得直接寫入，Admin SDK 後端由 IAM／驗證保護 ──
    match /hr/{docId} {
      allow read:  if isStaffA();
      allow write: if isStaffA() && !(docId in ['employees', 'resigned', '_version']);
    }
    // 排除全域兜底後，保留原有 admin 對其他 hr 文件／深層路徑的權限。
    // v2 遞迴萬用字元亦可匹配零層；來源根文件和深層都必須擋寫。
    match /hr/{docId}/{nested=**} {
      allow read: if isAdminA();
      allow write: if isAdminA() && !(docId in ['employees', 'resigned', '_version']);
    }
    match /hr_source_audit/{document=**} {
      allow read: if isAdminA();
      allow write: if false;
    }
    match /settings/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdminA();
    }
    match /settings/recruit104 {
      allow read:  if isLoggedIn();
      allow write: if isStaffA();
    }

    // ── 以下維持基準版邏輯，僅把 isStaff/isAdmin 換成帶 isActive 的版本 ──
    match /salary_records/{docId}   { allow read, write: if isStaffA(); }
    match /salary_settings/{docId}  { allow read, write: if isStaffA(); }
    match /store_accounts/{docId}   { allow read, write: if isStaffA(); }
    match /schedules/{docId}        { allow read: if isLoggedIn(); allow write: if isStaffA(); }
    match /shift_types/{docId}      { allow read: if isLoggedIn(); allow write: if isStaffA(); }
    match /meeting_records/{doc}    { allow read, write: if isStaffA(); }
    match /meeting_records/{doc}/versions/{ver} { allow read, write: if isStaffA(); }
    match /price_reports/{docId}    { allow read, write: if isStaffA(); }
    match /price_settings/{docId}   { allow read: if isLoggedIn(); allow write: if isAcctMgrA(); }
    match /cctv_reports/{docId}     { allow read, write: if isStaffA(); }
    match /delivery_reports/{docId} { allow read, write: if isStaffA(); }
    match /delivery_personnel/{docId} { allow read, write: if isStaffA(); }
    match /store_tasks/{docId}      { allow read, write: if isStaffA(); }
    match /cost_items/{docId}       { allow read, write: if isStaffA(); }
    match /cost_products/{docId}    { allow read, write: if isStaffA(); }
    match /cost_platforms/{docId}   { allow read, write: if isStaffA(); }
    match /cost_settings/{docId}    { allow read: if isLoggedIn(); allow write: if isStaffA(); }
    match /departure_alerts/{docId} { allow read, write: if isStaffA(); }
    match /hr_backups/{docId}       { allow read, write: if isAdminA(); }
    match /recruit104_schedule/{docId} { allow read: if isLoggedIn(); allow write: if isAdminA(); }

    match /attendance/{docId}          { allow create: if isLoggedIn(); allow read, update, delete: if isStaffA(); }
    match /attendance_anomaly/{docId}  { allow create: if isLoggedIn(); allow read, update, delete: if isStaffA(); }
    match /attendance_temp/{docId}     { allow create: if isLoggedIn(); allow read, update, delete: if isStaffA(); }
    match /punch_records/{docId}       { allow create: if isLoggedIn(); allow read, update, delete: if isStaffA(); }

    match /sys_oplogs/{docId} { allow create: if isLoggedIn(); allow read, update, delete: if isAdminA(); }
    match /hr_oplogs/{docId}  { allow create: if isLoggedIn(); allow read, update, delete: if isAdminA(); }

    match /push_tokens/{uid} { allow read, write: if isLoggedIn() && request.auth.uid == uid; }
    match /push_inbox/{uid} {
      allow read: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isLoggedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }
    match /push_log/{docId} { allow read: if isAdminA(); allow write: if false; }

    match /devices/{uid} { allow read, write: if isLoggedIn() && request.auth.uid == uid; }

    // Backend-only sync state, snapshots, outbox, nonces and security metadata.
    // Explicit deny is insufficient on its own: the admin catchall also excludes this root.
    match /hr_msgc_v1/{document=**} {
      allow read, write: if false;
    }

    // ── 兜底規則 ──
    // ⚠ Firestore 多條規則同時匹配時是 OR 語意：只要有一條 allow 就放行，
    //   細規則【不會】覆蓋粗規則。
    //   原本的 `match /{document=**}` 會一併匹配 /users/{uid}，
    //   使上面「admin 不得自改權限欄位、不得刪除自己」形同虛設
    //   （2026/09/17 模擬器實測 G9/G10 因此失敗，G11 為其連鎖結果）。
    //
    //   解法：兜底改為 `/{col}/{doc=**}`，精確排除 users、hr、hr_source_audit，
    //   讓這些集合只受上面明確規則管轄，避免 admin 兜底繞過來源寫入限制。
    //   ⚠ 新增集合若未在本檔列出，會落到這條兜底（admin 可讀寫）。
    match /{col}/{doc=**} {
      allow read, write: if isAdminA() && !(col in ['users', 'hr', 'hr_source_audit', 'hr_msgc_v1']);
    }
  }
}
